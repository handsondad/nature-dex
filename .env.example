# ─────────────────────────────────────────────
# AI Agent 应用环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ⚠️ 警告：.env 文件包含敏感信息，不要提交到版本库！
# ─────────────────────────────────────────────

# ── LLM 配置 ──────────────────────────────────
# OpenAI API Key（未来接入外部模型时使用；当前目录问答不需要）
OPENAI_API_KEY=sk-your-api-key-here

# 自定义 API 端点（可选，默认使用 OpenAI 官方）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认模型（可选）
# OPENAI_MODEL=gpt-4o

# ── 应用配置 ───────────────────────────────────
# 服务端口（默认 8000）
PORT=8000

# 开发服务默认仅绑定本机；当前无账号鉴权，不要对公网开放
HOST=127.0.0.1

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 最大并发会话数（默认 10）
MAX_CONCURRENT_SESSIONS=10

# ── 数据库配置（如果使用）────────────────────────
# 本地 MVP：观察、寻找清单和图鉴共用的 SQLite 文件
NATURE_DEX_DB_PATH=.data/nature-dex.sqlite3
# DATABASE_URL=******localhost:5432/aiagent

# ── Redis 配置（如果使用）────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── GitHub 集成（Symphony 使用）───────────────────
# GitHub Personal Access Token（用于 Symphony 读取 Issues）
# GITHUB_TOKEN=ghp_your-token-here

# 仓库标识符（owner/repo 格式）
# GITHUB_REPOSITORY=your-org/your-repo

# Symphony 工作空间根目录
# SYMPHONY_WORKSPACE_ROOT=/tmp/symphony_workspaces

# ── 安全配置 ───────────────────────────────────
# JWT 密钥（生产环境必须使用强随机字符串）
# SECRET_KEY=your-secret-key-change-in-production

# API 访问令牌（可选，用于保护 API 端点）
# API_TOKEN=your-api-token-here
